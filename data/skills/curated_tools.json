    "id": "metaphlan-4",
    "type": "tool",
    "data": {
      "name": "MetaPhlAn 4",
      "version": "4.2.4",
      "description": "用于从宏基因组鸟枪法测序数据中进行物种级微生物组成分析的工具（细菌、古菌、真核生物和病毒）",
      "category": "profiling",
      "url": "https://github.com/biobakery/metaphlan",
      "repo_url": null,
      "homepage": "https://segatalab.cibio.unitn.it/tools/metaphlan/",
      "paper_url": "https://www.nature.com/articles/s41587-023-01688-w",
      "installation": "conda install -c bioconda metaphlan",
      "usage_example": "# 基本运行\nmetaphlan input.fastq.gz --output_file profile.txt\n\n# 使用病毒数据库\nmetaphlan input.fastq.gz --output_file profile.txt --input_type fastq --nproc 8\n\n# 菌株级分析\nmetaphlan input.fastq.gz --output_file profile.txt --strain_profiler true",
      "tags": [
        "metagenomics",
        "taxonomic-profiling",
        "species-level",
        "strain-level",
        "virus"
