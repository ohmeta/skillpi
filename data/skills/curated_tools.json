  {
    "id": "humann-3",
    "type": "tool",
    "data": {
      "name": "HUMAnN 3",
      "version": "3.0",
      "description": "用于从宏基因组或宏转录组数据中高效、准确地分析微生物群落通路存在/缺失和丰度的流程（功能分析）",
      "category": "functional-profiling",
