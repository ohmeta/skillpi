  {
    "id": "dada2-pipeline",
    "type": "tool",
    "data": {
      "name": "DADA2",
      "version": "1.30",
      "description": "高分辨率的样本推断算法，可从扩增子测序数据中精确识别序列变异（ASV），替代传统的 OTU 聚类方法",
      "category": "denoising",
      "url": "https://github.com/benjjneb/dada2",
      "repo_url": null,
      "homepage": "https://benjjneb.github.io/dada2/",
      "paper_url": "https://doi.org/10.1038/nmeth.3869",
      "installation": "# R/Bioconductor 安装\nif (!requireNamespace(\"BiocManager\", quietly = TRUE))\n    install.packages(\"BiocManager\")\nBiocManager::install(\"dada2\")\n\n# 或使用 QIIME 2 插件\nqiime dada2 denoise-paired ...",
      "usage_example": "# R 代码示例\nlibrary(dada2)\n\n# 1. 过滤和截断\nfiltFs <- filterAndTrim(fnFs, filtFs, truncLen=c(240,0))\n\n# 2. 学习错误率\nerrF <- learnErrors(filtFs)\n\n# 3. 去噪\ndadaFs <- dada(filtFs, err=errF)\n\n# 4. 合并双端 reads\nmergers <- mergePairs(dadaFs, filtFs, dadaRs, filtRs)\n\n# 5. 构建 ASV 表\nseqtab <- makeSequenceTable(mergers)",
      "tags": [
        "16S",
        "denoising",
        "ASV",
        "amplicon",
        "R",
        "bioconductor"
      ],
      "skill_level": "intermediate",
      "last_updated": "2026-03-18T13:01:06.427063"
    },
    "created_at": "2026-03-18T13:01:06.427065",
    "updated_at": "2026-03-18T13:01:06.427065"
  },
  {
    "id": "mothur",
    "type": "tool",
    "data": {
      "name": "Mothur",
      "version": "1.48.5",
      "description": "用于微生物生态学分析的综合工具，专注于 16S rRNA 基因序列分析和微生物群落多样性研究",
      "category": "amplicon-analysis",
      "url": "https://github.com/mothur/mothur",
      "repo_url": null,
      "homepage": "https://www.mothur.org",
      "paper_url": "https://doi.org/10.1128/AEM.01541-09",
      "installation": "# Ubuntu/Debian\nsudo apt-get install mothur\n\n# Conda\nconda install -c bioconda mothur\n\n# 源码编译\ngit clone https://github.com/mothur/mothur.git\ncd mothur\nmake -j",
      "usage_example": "# 标准 MiSeq SOP\nmothur > make.contigs(file=stability.files, processors=8)\nmothur > screen.seqs(fasta=current, maxambig=0, maxlength=275)\nmothur > unique.seqs(fasta=current)\nmothur > align.seqs(fasta=current, reference=silva.v4.fasta)\nmothur > filter.seqs(fasta=current, vertical=T, trump=.)\nmothur > pre.cluster(fasta=current, diffs=2)\nmothur > chimera.vsearch(fasta=current)\nmothur > classify.seqs(fasta=current, reference=trainset9_032012.pds.fasta)\nmothur > cluster.split(fasta=current, count=current, splitmethod=classify)",
      "tags": [
        "16S",
        "amplicon",
        "OTU",
        "diversity",
        "SOP"
      ],
      "skill_level": "intermediate",
      "last_updated": "2026-03-18T13:01:06.427070"
    },
    "created_at": "2026-03-18T13:01:06.427071",
    "updated_at": "2026-03-18T13:01:06.427071"
  },
