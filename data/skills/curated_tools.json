  {
    "id": "qiime2-amplicon",
    "type": "tool",
    "data": {
      "name": "QIIME 2 (Amplicon)",
      "version": null,
      "description": "强大的微生物组扩增子分析平台，支持从原始测序数据到统计分析和可视化的完整流程",
      "category": "amplicon-analysis",
      "url": "https://github.com/qiime2/qiime2",
      "repo_url": null,
      "homepage": "https://qiime2.org",
      "paper_url": "https://doi.org/10.1038/s41587-019-0209-9",
      "installation": "# Conda 安装（推荐）\nconda install -c qiime2 -c conda-forge qiime2\n\n# Docker 安装\ndocker pull qiime2/core:2024.2",
      "usage_example": "# 导入数据\nqiime tools import \\\n  --type 'SampleData[SequencesWithQuality]' \\\n  --input-path demux \\\n  --output-path demux.qza\n\n# DADA2 去噪\nqiime dada2 denoise-paired \\\n  --i-demultiplexed-seqs demux.qza \\\n  --o-table table.qza \\\n  --o-representative-sequences rep-seqs.qza \\\n  --o-denoising-stats stats.qza\n\n# 多样性分析\nqiime diversity core-metrics-phylogenetic \\\n  --i-phylogeny rooted-tree.qza \\\n  --i-table table.qza \\\n  --p-sampling-depth 10000 \\\n  --output-dir core-metrics-results",
      "tags": [
        "16S",
        "amplicon",
        "its",
        "analysis",
        "visualization",
        "reproducible"
      ],
      "skill_level": "intermediate",
      "last_updated": "2026-03-18T13:01:06.427057"
    },
    "created_at": "2026-03-18T13:01:06.427059",
    "updated_at": "2026-03-18T13:01:06.427059"
